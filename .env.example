# すべて空のままでも「デモモード」で画面の流れを確認できます（絵は仮の画像、決済はスキップ）。

# Supabase（データベースと写真の保存先）: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI（挿絵の生成）
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_FINAL_SIZE=2048x2048

# Stripe（決済）: まずはテストモードのキー（sk_test_...）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 管理画面 /admin のパスワード（ユーザー名は admin）
ADMIN_PASSWORD=

# 写真の自動削除（Vercel Cron）用の合言葉。長いランダムな文字列にする
CRON_SECRET=

# 公開URL（未設定ならアクセスされたURLを使う）
# SITE_URL=https://example.com
